{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://x402.org/schemas/domain-discovery.schema.json",
  "title": "x402 Domain Discovery Manifest",
  "description": "Authoritative RFC 8615 well-known domain discovery manifest for x402 payment-enabled origins (/.well-known/x402).",
  "type": "object",
  "required": [
    "x402Version"
  ],
  "properties": {
    "x402Version": {
      "type": "integer",
      "enum": [2],
      "description": "The x402 protocol specification version. Must be 2."
    },
    "kind": {
      "description": "The operational role of this host in the x402 topology.",
      "oneOf": [
        {
          "type": "string",
          "enum": ["resource-server", "facilitator", "both"]
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["resource-server", "facilitator", "both"]
          },
          "minItems": 1,
          "uniqueItems": true
        }
      ]
    },
    "facilitator": {
      "type": "string",
      "format": "uri",
      "description": "Optional URI pointing to an external authoritative facilitator service."
    },
    "keys": {
      "type": "array",
      "description": "Host-level cryptographic public keys for manifest and challenge signature verification.",
      "items": {
        "$ref": "#/$defs/verificationKey"
      }
    },
    "resources": {
      "type": "array",
      "description": "Payment-enabled endpoints and services served by this host.",
      "items": {
        "$ref": "#/$defs/resourceEndpoint"
      }
    },
    "openapi": {
      "description": "Optional pointer to developer documentation and OpenAPI descriptions. Strictly informational; payment discovery is resolved directly via resources.",
      "oneOf": [
        {
          "type": "string",
          "format": "uri"
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          },
          "minItems": 1
        }
      ]
    }
  },
  "anyOf": [
    {
      "required": ["resources"],
      "description": "Resource servers must declare the resources array."
    },
    {
      "properties": {
        "kind": {
          "oneOf": [
            { "const": "facilitator" },
            {
              "type": "array",
              "contains": { "const": "facilitator" }
            }
          ]
        }
      },
      "required": ["kind"],
      "description": "Hosts acting as standalone facilitators may omit the resources array."
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "atomicAmount": {
      "type": "string",
      "pattern": "^[0-9]+$",
      "description": "Non-negative integer string representing asset quantity in its smallest atomic denomination (e.g. satoshis, base units)."
    },
    "verificationKey": {
      "type": "object",
      "required": [
        "kid",
        "alg",
        "publicKey"
      ],
      "properties": {
        "kid": {
          "type": "string",
          "minLength": 1,
          "description": "Key identifier, matching DNS TXT ground truth records."
        },
        "alg": {
          "type": "string",
          "enum": ["Ed25519", "ES256", "ES256K"],
          "description": "Cryptographic signature algorithm."
        },
        "publicKey": {
          "type": "string",
          "minLength": 1,
          "description": "Public key encoded in hex or base64."
        }
      },
      "additionalProperties": false
    },
    "paymentOption": {
      "type": "object",
      "required": [
        "scheme",
        "network"
      ],
      "properties": {
        "scheme": {
          "type": "string",
          "enum": ["exact", "upto", "batch-settlement", "escrow"],
          "description": "The x402 payment and settlement scheme."
        },
        "network": {
          "type": "string",
          "pattern": "^[a-z0-9-]{3,8}:[-_a-zA-Z0-9]{1,64}$",
          "description": "Canonical CAIP-2 blockchain network identifier."
        },
        "asset": {
          "type": "string",
          "minLength": 1,
          "description": "Settlement asset contract address, currency code, or native symbol."
        },
        "amount": {
          "$ref": "#/$defs/atomicAmount"
        },
        "minAmount": {
          "$ref": "#/$defs/atomicAmount"
        },
        "maxAmount": {
          "$ref": "#/$defs/atomicAmount"
        },
        "recipient": {
          "type": "string",
          "description": "Authoritative payee address or account identifier."
        },
        "extra": {
          "type": "object",
          "description": "Optional scheme-specific parameters."
        }
      },
      "additionalProperties": false
    },
    "resourceEndpoint": {
      "type": "object",
      "required": [
        "path",
        "accepts"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "URL path or URI template of the monetized resource."
        },
        "description": {
          "type": "string",
          "description": "Human and agent readable summary of the resource."
        },
        "methods": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["GET", "POST", "PUT", "DELETE", "PATCH", "HEAD", "OPTIONS"]
          },
          "minItems": 1,
          "uniqueItems": true,
          "description": "HTTP methods applicable to this payment requirement. Defaults to all methods if omitted."
        },
        "accepts": {
          "type": "array",
          "minItems": 1,
          "description": "Supported payment options for this endpoint.",
          "items": {
            "$ref": "#/$defs/paymentOption"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
